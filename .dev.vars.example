# Copy to .dev.vars (gitignored). Values here are Worker bindings for `wrangler dev` only.
# They do NOT change which Cloudflare account wrangler deploys to.
# Deploy ONLY with ~/RamenProtocol/_ops/infra/ramen-deploy.sh (see scripts/deploy.sh) — it refuses
# unless the Ramen account id and token are set, so the global wrangler login is never used.
#
# Leave ANTHROPIC_API_KEY unset to run in demo mode. Setting a real key locally
# makes paid API calls. In production it is a secret: `wrangler secret put ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=
# Optional: point the SDK at a local mock server instead of the real API.
ANTHROPIC_BASE_URL=
